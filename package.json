{
  "name": "loopwell",
  "version": "2.0.0",
  "description": "A tactile beat maker that lives in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "kits": "tsx scripts/build-kits.ts",
    "test:realtime": "tsx scripts/realtime-check.ts",
    "test:e2e": "vite build && tsx tests/e2e/run.ts",
    "bench": "tsx scripts/bench.ts",
    "demos": "tsx scripts/demo-links.ts",
    "test:community": "vite build && tsx tests/e2e/community.ts",
    "test:live": "vite build && tsx tests/e2e/live.ts",
    "test:tools": "vite build && tsx tests/e2e/creative.ts",
    "test:sounds": "vite build && tsx tests/e2e/instruments.ts",
    "test:stage": "vite build && tsx tests/e2e/stage.ts",
    "test:mix": "vite build && tsx tests/e2e/mix.ts",
    "test:workflow": "vite build && tsx tests/e2e/workflow.ts",
    "test:onboarding": "vite build && tsx tests/e2e/onboarding.ts",
    "test:polish": "vite build && tsx tests/e2e/polish.ts",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "fflate": "^0.8.3",
    "wasm-media-encoders": "^0.7.0",
    "yjs": "^13.6.33"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aubergine-ux/loopwell.git"
  },
  "homepage": "https://aubergine-ux.github.io/loopwell/",
  "author": "Aubergine-UX",
  "private": true
}
