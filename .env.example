# Settings for the optional Loopwell backend (see server/README.md).
# Copy this file to .env. docker compose reads it from here; when running the
# server directly, `npm run dev` in server/ reads the same file.
# Every value shown is the default; a line left commented out keeps it.

# --- where things live -------------------------------------------------------

# Port published on the host by docker compose.
#API_PORT=8787

# Port the server listens on when run directly (inside compose it is always 8787).
#PORT=8787
#HOST=0.0.0.0

# The URL browsers and OAuth providers reach this API at, without a trailing
# slash. OAuth callback URLs are built from it, so it must match what you
# registered with GitHub and Discord.
PUBLIC_URL=http://localhost:8787

# Comma-separated origins of the Loopwell app that may use this API. Used for
# CORS and to validate where sign-in may redirect back to. For the hosted app:
# https://aubergine-ux.github.io
APP_ORIGINS=http://localhost:5173

# Set to 1 when the API sits behind a reverse proxy that sets X-Forwarded-For,
# so rate limits and play counts see the real client address.
#TRUST_PROXY=0

# "production" is the default under docker compose.
#NODE_ENV=production

# Request logging to stdout (1 or 0).
#LOG=1

# --- sign-in -----------------------------------------------------------------

# A provider is enabled when both its id and secret are set.
# GitHub callback URL to register:  <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Discord redirect to register:     <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Provider endpoints. Only change these to point at a GitHub Enterprise
# instance or a test double.
#GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
#GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
#GITHUB_USER_URL=https://api.github.com/user
#DISCORD_AUTHORIZE_URL=https://discord.com/oauth2/authorize
#DISCORD_TOKEN_URL=https://discord.com/api/oauth2/token
#DISCORD_USER_URL=https://discord.com/api/users/@me

# How long a sign-in lasts.
#SESSION_TTL_DAYS=30

# Comma-separated Loopwell handles that are admins (moderation tools).
ADMIN_HANDLES=

# Lets anyone get a token for any handle via POST /api/auth/dev-login, with no
# OAuth app. For local development only: ignored when NODE_ENV=production.
#DEV_LOGIN=0

# Key for hashing client addresses in play counts. Set it to a long random
# string so the hashes stay stable across restarts; when empty a new one is
# generated at every start.
IP_HASH_SECRET=

# --- database and storage ----------------------------------------------------

# docker compose: passwords for the bundled Postgres and MinIO. Change them.
POSTGRES_PASSWORD=loopwell
MINIO_ROOT_USER=loopwell
MINIO_ROOT_PASSWORD=loopwell-secret
S3_BUCKET=loopwell

# Running the server without docker compose: set these yourself. (Compose
# fills them in for its own Postgres and MinIO and ignores what is here.)
#DATABASE_URL=postgres://loopwell:loopwell@localhost:5432/loopwell
#S3_ENDPOINT=http://localhost:9000
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Path-style addressing; on by default whenever S3_ENDPOINT is set.
#S3_FORCE_PATH_STYLE=1
# Without S3_BUCKET, files go to this directory instead.
#STORAGE_DIR=./data/storage

# --- limits ------------------------------------------------------------------

# Largest project file (cloud save or published beat).
#MAX_PROJECT_MB=30
# Versions kept per cloud save; older ones are deleted.
#MAX_PROJECT_VERSIONS=50
# Storage per account across cloud saves, published beats and samples.
#USER_QUOTA_MB=1024
# Sample packs: largest file, longest sample (checked for WAV, AIFF and FLAC),
# most files per pack, most megabytes per pack.
#MAX_SAMPLE_MB=10
#MAX_SAMPLE_SECONDS=60
#MAX_PACK_FILES=64
#MAX_PACK_MB=200

# Requests per client address: overall, on sign-in routes, on uploads.
#RATE_LIMIT_PER_MINUTE=300
#RATE_LIMIT_AUTH_PER_MINUTE=30
#RATE_LIMIT_UPLOADS_PER_MINUTE=60
# Reports per signed-in user.
#RATE_LIMIT_REPORTS_PER_HOUR=10
