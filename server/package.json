{
  "name": "loopwell-server",
  "version": "3.0.0",
  "description": "Optional self-hosted backend for Loopwell: accounts, cloud saves, a beat gallery and sample packs.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
